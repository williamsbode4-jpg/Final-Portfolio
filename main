<script>
  function show(){
    var id = (location.hash || '#home').slice(1);
    if(!document.getElementById('p-' + id)) id = 'home';
    var pages = document.querySelectorAll('section.page');
    for(var i = 0; i < pages.length; i++){ pages[i].classList.remove('show'); }
    document.getElementById('p-' + id).classList.add('show');
    var links = document.querySelectorAll('.links a');
    for(var j = 0; j < links.length; j++){
      links[j].classList.toggle('active', links[j].getAttribute('data-p') === id);
    }
    window.scrollTo(0, 0);
  }
  window.addEventListener('hashchange', show);
  show();
</script>
